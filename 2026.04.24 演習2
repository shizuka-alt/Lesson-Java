第9章　クラスの基礎

●クラス
問1．
・Person.java

public class Person {

	//名前と年齢のフィールドを持たせる
	//fillingと同じフィールドで作ることはできない
	String fillingName;
	Integer fillingAge; //intでもOK
	
	//コンストラクタ
　　//上のfillingName、fillingAgeとname、ageとを紐づけるため。
	public Person (String name, Integer age) {
		this.fillingName = name;
		this.fillingAge = age;
	}
	
}

・Main.java

public class Main {

	public static void main(String[] args) {
		
		//インスタンスの生成
		Person p = new Person("田中", 20);
		
		//フィールド値を表示
		System.out.println("名前：" + p.fillingName);
		System.out.println("年齢：" + p.fillingAge);
	}
	
}


問2．
・Book.java
public class Book {

	String title;
	String author;
	Integer price;
	
	//コンストラクタ。中身をセットするメソッド
	public Book(String title, String author, Integer price) {
		
		this.title = title;
		this.author = author;
		this.price = price;
		
	}
	
	//中身を表示するメソッド
	public void showInfo() {
		System.out.println("タイトル：" + title);
		System.out.println("著者：" + author);
		System.out.println("価格：" + price + "円");
	}
	
}

・Main.java
public class Main {

	public static void main(String[] args) {
		//インスタンスを生成
		Book myBook = new Book("Java入門","山田太郎",2500);
		
		//メソッドを呼び出して情報を表示
		myBook.showInfo();
		
		
	}
	
}

問3．
・Student.java
public class Student {

	String name;
	int[] scores; //int型の配列。ここに成績を入れる。
	
	//コンストラクタ
	public Student(String name, int[] scores) {
		
		this.name = name;
		this.scores = scores;
		
	}
	
	//平均点を計算して表示するメソッド
	public void showAverage() {
		int sum = 0;
		//配列の中身を全部足す
		for (int score : scores) {
			sum += score;
			
		}
	
		//平均を計算する
		double average = (double) sum / scores.length;
		
		System.out.println(name + "さんの平均点は" + average + "点です。");
		
		
	}
	
	
	
}

