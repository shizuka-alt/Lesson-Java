問4．
・Employee.java
public class Employee {

	int id;
	String name;
	double salary;
	
	//コンストラクタ。中身をセットするメソッド。
	public Employee(int id, String name, double salary) {
		this.id = id;
		this.name = name;
		this.salary = salary;
	}
	
	//中身を表示するメソッド
	public void raiseSalary(double percent) {
		//給与を更新する
		this.salary = this.salary * (1 + percent / 100);
		
		System.out.println(name + "さんの給与が" + percent + "% 昇給しました。");
		System.out.println("現在の給与：" + this.salary + "円");
		
	}
	
	
}

・Main.java
public class Main04 {

	public static void main(String[] args) {
		//インスタンスを生成。
		Employee emp = new Employee(101, "佐藤", 200000);
		
		//上のインスタンスを使って、5%昇給させる
		emp.raiseSalary(5.0);
		
		
	}
	
}

問5．
・Circle.java

public class Circle {

	
	double radius;
	
	//コンストラクタ
	public Circle(double radius) {
		this.radius = radius;
		
	}
	
	//中身を表示するメソッド
	public void showArea() {
		double area = radius * radius * Math.PI;
		
		System.out.println("半径" + radius + "の円の面積は" + area + "です。");
		
	}
	
}

・Main.java

public class Main05 {

	public static void main(String[] args) {
		
		//オブジェクトを用意
		Circle myCircle = new Circle(5.0);
		
		//myCircle というオブジェクトに対して、
		//showArea という機能を実行する（適用する）
		myCircle.showArea();
		
		
	}
	
}


