package jp.co.aforce.sample.training20260422;

import java.util.ArrayList;
import java.util.List;

public class training6_2_1 {

	public static void main(String[] args) {
		
		List<Integer> numList = new ArrayList<Integer>();
		
		numList.add(10);
		numList.add(20);
		numList.add(30);
		numList.add(40);
		numList.add(50);
		
		//探したい値を変数に設定する
		int searchNum = 30;
		
		if (numList.contains(searchNum)) {
            System.out.println(searchNum + " はリストに含まれています。");
        } else {
            System.out.println(searchNum + " はリストに含まれていません。");
        }
	}
	
}

