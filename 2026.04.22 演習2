package jp.co.aforce.sample.training20260422;

import java.util.ArrayList;
import java.util.HashSet;
import java.util.List;
import java.util.Set;

public class training6_1_2 {

	public static void main(String[] args) {
		
		List<Integer> numList = new ArrayList<Integer>();

		numList.add(10);
		numList.add(20);
		numList.add(30);
		numList.add(40);
		numList.add(50);
		
		System.out.println("変換前："+ numList);
		
		//ArrayListをHashSetに変換(ここで重複が消える)
		Set<Integer> numSet = new HashSet<>(numList);
		
		System.out.println("変換後："+ numSet);
	}
}

