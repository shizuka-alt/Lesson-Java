package jp.co.aforce.sample.training20260423;

public class ForTraining03 {

	public static void main(String[] args) {
		//表示するのはn2だけ、n1は計算のためにだけいる。
		int n1 = 0; //2つ前の数
		int n2 = 1; //1つ前の数
		
		System.out.println("フィボナッチ数列の最初の10項:");
		
		for (int i = 1; i <= 10; i++) {
			System.out.println(n2 + ""); //現在の項(n2)を表示
			
			int next = n1 + n2; //1+1=2とか
			
			//次のループのために、数字をスライドさせる
			n1 = n2; //「1つ前」を「2つ前」へ
			n2 = next; //「次の数」を「1つ前」へ
		}
		
	}
	
}

