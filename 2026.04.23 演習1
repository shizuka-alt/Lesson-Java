package jp.co.aforce.sample.training20260423;

import java.util.Scanner;

public class DoWhileTraining03 {

	public static void main(String[] args) {
		//インスタンスを生成
		Scanner sc = new Scanner(System.in);
		int sum = 0; //合計をためる変数
		int num; //入力された値を保持する変数
		
		do {
			System.out.println("整数を入力してください(0で終了):");
			num = sc.nextInt(); //ここで入力を受け取る(とりあえず1回目を実行)
			
			sum += num; //入力された値を合計に足す
			
		} while (num != 0); //0でなければ、もう一度doの中身を実行する
		
		System.out.println("合計:" + sum);
		
		sc.close();
		
	}
	
}

