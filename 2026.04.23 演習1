package jp.co.aforce.sample.training20260423;

import java.util.Scanner;

public class WhileTraining03 {

	public static void main(String[] args) {
		//インスタンスを生成
		Scanner sc = new Scanner(System.in);
		int sum = 0; //合計をためる変数
		
		System.out.println("整数を入力してください:");
		
		//整数をnumに入力
		int num = sc.nextInt();
		
		//0以外の間はずっと繰り返す
		while (num != 0) {
			sum += num; //sum = sum + num
			
			System.out.println("次の整数を入力してください:");
			num = sc.nextInt(); //ループの中でもう一度入力させる
		}
			
			
		System.out.println(sum);
		sc.close();
		
	}
	
}

