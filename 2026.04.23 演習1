package jp.co.aforce.sample.training20260423;

public class ForEachTraining03 {

	public static void main(String[] args) {
		//配列を作成
		int[] numbers = {10, 20, 30, 40, 50};
		
		int sum = 0;
		
		//拡張for文で合計を計算する
		//numbersから1つずつnに取り出す
		for (int n : numbers) {
			sum += n; //取り出した数字をsumに足していく
		}
		
		System.out.println("合計は " + sum + " です。");
		
	}
	
}

